{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "rspress-doc-template#build": {
      "dependsOn": ["^build"],
      "outputs": ["doc_build/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [".eslintcache"]
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "download:piano": {}
  }
}

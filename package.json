{
  "name": "muse-player",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "MXL/MusicXML score rendering and playback monorepo",
  "author": {
    "email": "admin@rikka.cc",
    "name": "Rikka",
    "url": "https://github.com/Muromi-Rikka"
  },
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -F demo dev",
    "build": "pnpm -F @muse-player/core build && pnpm -F demo build",
    "build:core": "pnpm -F @muse-player/core build",
    "build:demo": "pnpm -F demo build",
    "lint": "eslint . --cache --max-warnings=3 --no-warn-ignored",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@muse-player/instruments": "workspace:*",
    "@renton/eslint-config-react": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "typescript": "^6.0.3"
  }
}

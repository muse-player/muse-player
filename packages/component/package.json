{
  "name": "@muse-player/component",
  "type": "module",
  "version": "1.0.0",
  "description": "UI components for Muse Player, styled with StyleX",
  "author": {
    "email": "admin@rikka.cc",
    "name": "Rikka",
    "url": "https://github.com/Muromi-Rikka"
  },
  "license": "MIT",
  "homepage": "https://github.com/muse-player/muse-player#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/muse-player/muse-player.git",
    "directory": "packages/component"
  },
  "bugs": {
    "url": "https://github.com/muse-player/muse-player/issues"
  },
  "keywords": [
    "musicxml",
    "mxl",
    "score",
    "react",
    "ui",
    "playback",
    "controls",
    "stylex"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/stylex_bundle.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && rslib build && node scripts/extract-stylex.mjs",
    "dev": "rslib build --watch",
    "lint": "eslint . --cache"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "@muse-player/core": "workspace:*",
    "@stylexjs/stylex": "^0.19.0"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/plugin-transform-typescript": "^8.0.1",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": "^1.0.0",
    "@stylexjs/cli": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}

{
  "name": "@muse-player/core",
  "type": "module",
  "version": "1.0.0",
  "description": "Core components and hooks for MXL/MusicXML score rendering and playback",
  "author": {
    "email": "admin@rikka.cc",
    "name": "Rikka",
    "url": "https://github.com/Muromi-Rikka"
  },
  "license": "MIT",
  "homepage": "https://github.com/Muromi-Rikka/muse-player#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muromi-Rikka/muse-player.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Muromi-Rikka/muse-player/issues"
  },
  "keywords": [
    "musicxml",
    "mxl",
    "score",
    "verovio",
    "tone.js",
    "midi",
    "react",
    "hooks",
    "rendering",
    "playback"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks/*": {
      "types": "./dist/src/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "eslint . --cache"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "@muse-player/instruments": "workspace:*",
    "@tonejs/midi": "^2.0.28",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": "^1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}

{
  "name": "@muse-player/server",
  "type": "module",
  "version": "1.0.0",
  "description": "Node.js library for server-side MXL/MusicXML score rendering via Verovio",
  "author": {
    "email": "admin@rikka.cc",
    "name": "Rikka",
    "url": "https://github.com/Muromi-Rikka"
  },
  "license": "MIT",
  "homepage": "https://github.com/Muromi-Rikka/muse-player#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muromi-Rikka/muse-player.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/Muromi-Rikka/muse-player/issues"
  },
  "keywords": [
    "musicxml",
    "mxl",
    "score",
    "verovio",
    "rendering",
    "node.js",
    "server-side"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "eslint . --cache"
  },
  "dependencies": {
    "@muse-player/core": "workspace:*",
    "verovio": "^6.3.0"
  },
  "devDependencies": {
    "@rslib/core": "^1.0.0",
    "@types/node": "^26.5.1",
    "@types/verovio": "^5.1.0",
    "typescript": "^6.0.3"
  }
}
